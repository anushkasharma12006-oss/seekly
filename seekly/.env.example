# ==========================================
# SEEKLY — Environment Configuration
# ==========================================

# Server Host & Port
SEEKLY_HOST=127.0.0.1
SEEKLY_PORT=8000

# AI Provider Credentials (Optional)
# If provided, Gemini will synthesize deep answers with full web grounding.
# If omitted, Seekly uses its built-in local grounded synthesizer from live search snippets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Search Provider Credentials (Optional)
# DuckDuckGo live search works immediately out-of-the-box with NO API KEY.
# If you prefer Tavily or SerpAPI, enter keys below:
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Default Search Provider: "duckduckgo", "tavily", or "demo"
DEFAULT_SEARCH_PROVIDER=duckduckgo

# Default AI Provider: "auto", "gemini", or "local"
DEFAULT_AI_PROVIDER=auto

# Demo Mode: Set to "true" to force verified archival demo results without web querying
DEMO_MODE=false
